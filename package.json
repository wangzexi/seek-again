{
  "name": "seekagain",
  "version": "0.1.1",
  "private": true,
  "description": "一个支持微信登录、自动配置 DeepSeek API 和本机保存对话的聊天应用。",
  "license": "MIT",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "type": "bun run --cwd web type",
    "test": "bun run --cwd web test",
    "test:bdd": "bun run --cwd web test:bdd",
    "test:bdd:real": "bun run --cwd web test:bdd:real",
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "lint": "bun run --cwd web lint",
    "format": "oxfmt --write package.json web shared '!web/src/services/agent/fixtures/**'",
    "format:check": "oxfmt --check package.json web shared '!web/src/services/agent/fixtures/**'",
    "start": "cargo run --locked --manifest-path server/Cargo.toml",
    "test:server": "cargo test --locked --manifest-path server/Cargo.toml"
  },
  "devDependencies": {
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0"
  },
  "packageManager": "bun@1.4.2"
}
